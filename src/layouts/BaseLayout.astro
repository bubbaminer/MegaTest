---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = '', noindex = false } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <header class="border-b bg-white">
      <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between px-6">
        <a class="text-lg font-semibold" href="/">Digital Store</a>
        <nav aria-label="Основная навигация" class="flex items-center gap-6 text-sm text-muted">
          <a class="hover:text-ink" href="/catalog/">Каталог</a>
          <a class="hover:text-ink" href="/games/">Игры</a>
          <a class="hover:text-ink" href="/account">Аккаунт</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>
