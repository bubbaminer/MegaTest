---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string | undefined;
  canonicalUrl?: string | undefined;
  robots?: string | undefined;
  ogTitle?: string | undefined;
  ogDescription?: string | undefined;
  ogImageUrl?: string | undefined;
  structuredData?: Record<string, unknown> | undefined;
  noindex?: boolean | undefined;
}

const { title, description = '', canonicalUrl, robots, ogTitle, ogDescription, ogImageUrl, structuredData, noindex = false } = Astro.props;
const structuredDataJson = structuredData && Object.keys(structuredData).length > 0
  ? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
  : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : (robots ?? 'index,follow')} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <header class="border-b bg-white">
      <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between px-6">
        <a class="text-lg font-semibold" href="/">Digital Store</a>
        <nav aria-label="Основная навигация" class="flex items-center gap-6 text-sm text-muted">
          <a class="hover:text-ink" href="/catalog/">Каталог</a>
          <a class="hover:text-ink" href="/games/">Игры</a>
          <a class="hover:text-ink" href="/account">Аккаунт</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
  </body>
</html>
