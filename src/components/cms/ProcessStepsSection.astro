---
import type { SectionDataMap } from '@/lib/cms/sections';
interface Props { data: SectionDataMap['process_steps'] }
const { data } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 py-12 sm:py-16"><h2 class="text-3xl font-semibold tracking-tight">{data.title}</h2><ol class="mt-8 grid gap-5 md:grid-cols-3">{data.steps.map((step, index) => <li class="rounded-xl border p-6"><span class="text-sm font-semibold text-primary">Шаг {index + 1}</span><h3 class="mt-3 text-lg font-semibold">{step.title}</h3><p class="mt-2 text-sm leading-6 text-muted">{step.text}</p></li>)}</ol></section>
