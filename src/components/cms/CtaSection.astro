---
import type { SectionDataMap } from '@/lib/cms/sections';
interface Props { data: SectionDataMap['cta'] }
const { data } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
  <div class="rounded-xl border bg-primary-soft p-8 sm:flex sm:items-center sm:justify-between sm:gap-8">
    <div><h2 class="text-2xl font-semibold">{data.title}</h2>{data.text && <p class="mt-2 text-muted">{data.text}</p>}</div>
    <a class="mt-6 inline-flex min-h-11 shrink-0 items-center rounded-ui bg-primary px-5 py-3 font-semibold text-white sm:mt-0" href={data.action.url}>{data.action.label}</a>
  </div>
</section>
