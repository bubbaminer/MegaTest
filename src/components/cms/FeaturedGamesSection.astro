---
import type { SectionDataMap } from '@/lib/cms/sections';
import { listFeaturedGames } from '@/lib/catalog/public';
interface Props { data: SectionDataMap['featured_games'] }
const { data } = Astro.props;
const games = await listFeaturedGames(data.gameIds);
---
{games.length > 0 && <section class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
  <h2 class="text-3xl font-semibold">{data.title ?? 'Игры'}</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {games.map((game) => <a class="overflow-hidden rounded-xl border bg-white hover:border-primary" href={`/games/${game.slug}`}>
      {game.imageUrl && <img class="aspect-video w-full object-cover" src={game.imageUrl} alt={game.name} loading="lazy" />}
      <div class="p-5"><h3 class="text-xl font-semibold">{game.name}</h3>
        {game.shortDescription && <p class="mt-3 text-sm leading-6 text-muted">{game.shortDescription}</p>}
      </div>
    </a>)}
  </div>
</section>}
