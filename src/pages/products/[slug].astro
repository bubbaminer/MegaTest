---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getPublicProduct } from '@/lib/catalog/products';
const product = Astro.params.slug ? await getPublicProduct(Astro.params.slug) : null; if (!product) Astro.response.status = 404;
---
<BaseLayout title={product?.name ?? 'Товар не найден'} description={product?.shortDescription} noindex={!product}>{!product ? <section class="mx-auto max-w-3xl px-6 py-24"><h1 class="text-3xl font-semibold">Товар не найден</h1><a class="mt-6 inline-flex text-primary underline" href="/catalog/">Вернуться в каталог</a></section> : <section class="mx-auto grid max-w-6xl gap-10 px-6 py-12 lg:grid-cols-2">{product.imageUrl ? <img class="aspect-square w-full rounded-xl border object-cover" src={product.imageUrl} alt={product.name} /> : <div class="flex aspect-square items-center justify-center rounded-xl bg-primary-soft text-5xl" aria-hidden="true">◆</div>}<div><a class="text-sm text-primary underline" href="/catalog/">← Каталог</a><h1 class="mt-6 text-4xl font-semibold">{product.name}</h1>{product.shortDescription && <p class="mt-4 text-lg text-muted">{product.shortDescription}</p>}<div class="mt-8 flex items-baseline gap-3"><strong class="text-3xl">{product.formattedPrice}</strong>{product.formattedOldPrice && <s class="text-muted">{product.formattedOldPrice}</s>}</div>{product.description && <p class="mt-8 whitespace-pre-line leading-8">{product.description}</p>}<div class="mt-8 rounded-ui border bg-surface p-4 text-sm text-muted">Корзина и оформление заказа будут подключены на этапе e-commerce.</div></div></section>}</BaseLayout>
