---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CmsPageRenderer from '@/components/cms/CmsPageRenderer.astro';
import { getPublishedPage } from '@/lib/cms/repository';

const slug = Astro.params.slug?.replace(/^\/+|\/+$/g, '') ?? '';
const page = slug ? await getPublishedPage(slug) : null;
if (!page) Astro.response.status = 404;
---
<BaseLayout
  title={page?.metaTitle ?? page?.title ?? 'Страница не найдена'}
  description={page?.metaDescription}
  canonicalUrl={page?.canonicalUrl}
  robots={page?.robotsDirectives}
  ogTitle={page?.ogTitle}
  ogDescription={page?.ogDescription}
  ogImageUrl={page?.ogImageUrl}
  structuredData={page?.structuredData}
  noindex={!page}
>
  {page ? <CmsPageRenderer page={page} /> : <section class="mx-auto max-w-3xl px-6 py-24"><p class="text-sm font-semibold text-primary">404</p><h1 class="mt-3 text-3xl font-semibold">Страница не найдена</h1><a class="mt-6 inline-flex text-primary underline" href="/">Вернуться на главную</a></section>}
</BaseLayout>
