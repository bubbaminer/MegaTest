---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CmsPageRenderer from '@/components/cms/CmsPageRenderer.astro';
import { getPublishedPage } from '@/lib/cms/repository';

const page = await getPublishedPage('home');
if (!page) Astro.response.status = 503;
---
<BaseLayout
  title={page?.metaTitle ?? page?.title ?? 'Страница не настроена'}
  description={page?.metaDescription}
  canonicalUrl={page?.canonicalUrl}
  robots={page?.robotsDirectives}
  ogTitle={page?.ogTitle}
  ogDescription={page?.ogDescription}
  ogImageUrl={page?.ogImageUrl}
  structuredData={page?.structuredData}
  noindex={!page}
>
  {page ? <CmsPageRenderer page={page} /> : <section class="mx-auto max-w-3xl px-6 py-24"><h1 class="text-3xl font-semibold">Страница не настроена</h1><p class="mt-4 text-muted">Создайте и опубликуйте страницу с идентификатором home в CMS.</p></section>}
</BaseLayout>
