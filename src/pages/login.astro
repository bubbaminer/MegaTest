---
import BaseLayout from '@/layouts/BaseLayout.astro';
const error = Astro.url.searchParams.get('error');
const message = error === 'invalid' ? 'Неверный email или пароль.' : error === 'missing' ? 'Заполните оба поля.' : undefined;
---
<BaseLayout title="Вход" description="Вход в личный кабинет" noindex>
  <section class="mx-auto max-w-md px-6 py-16 sm:py-24">
    <h1 class="text-3xl font-semibold tracking-tight">Вход</h1>
    <p class="mt-3 text-muted">Используйте аккаунт Supabase Auth.</p>
    {message && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">{message}</div>}
    <form class="mt-8 space-y-5" method="post" action="/api/auth/login">
      <label class="block"><span class="mb-2 block text-sm font-medium">Email</span><input class="min-h-11 w-full rounded-ui border px-3" type="email" name="email" autocomplete="email" required /></label>
      <label class="block"><span class="mb-2 block text-sm font-medium">Пароль</span><input class="min-h-11 w-full rounded-ui border px-3" type="password" name="password" autocomplete="current-password" required /></label>
      <button class="min-h-11 w-full rounded-ui bg-primary px-5 py-3 font-semibold text-white" type="submit">Войти</button>
    </form>
  </section>
</BaseLayout>
