---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/cms/SectionRenderer.astro';
import { getPublicGame } from '@/lib/catalog/public';
const game = Astro.params.slug ? await getPublicGame(Astro.params.slug) : null;
if (!game) Astro.response.status = 404;
---
<BaseLayout title={game?.name ?? 'Игра не найдена'} description={game?.shortDescription} noindex={!game}>{!game?<section class="mx-auto max-w-3xl px-6 py-24"><p class="text-sm font-semibold text-primary">404</p><h1 class="mt-3 text-3xl font-semibold">Игра не найдена</h1><a class="mt-6 inline-flex text-primary underline" href="/catalog/">Вернуться в каталог</a></section>:<><section class="relative overflow-hidden border-b bg-surface">{game.bannerUrl&&<img class="absolute inset-0 h-full w-full object-cover opacity-15" src={game.bannerUrl} alt=""/>}<div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-24"><a class="text-sm text-primary underline" href="/catalog/">← Каталог</a><div class="mt-8 flex items-start gap-5">{game.logoUrl&&<img class="h-20 w-20 rounded-xl border bg-white object-cover" src={game.logoUrl} alt=""/>}<div><h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{game.name}</h1>{game.shortDescription&&<p class="mt-4 max-w-2xl text-lg leading-8 text-muted">{game.shortDescription}</p>}</div></div></div></section>{game.sections.length?game.sections.map((section)=><SectionRenderer section={section} gameId={game.id}/>):<><section class="mx-auto max-w-3xl px-6 py-12">{game.description&&<><h2 class="text-2xl font-semibold">Об игре</h2><p class="mt-4 whitespace-pre-line leading-8 text-muted">{game.description}</p></>}</section><section class="mx-auto max-w-6xl px-6 py-12"><div class="rounded-xl border border-dashed p-10 text-center"><h2 class="text-xl font-semibold">Добавьте блоки страницы</h2><p class="mt-2 text-muted">Контент и товарные позиции настраиваются в административной панели.</p></div></section></>}</>}</BaseLayout>
