---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCmsPageForAdmin } from '@/lib/cms/admin';
import { sectionTypes } from '@/lib/cms/sections';
import { sectionLabel, sectionTemplates } from '@/lib/cms/section-editor';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const page = Astro.params.id ? await getCmsPageForAdmin(auth.accessToken, Astro.params.id) : null;
if (!page) Astro.response.status = 404;
const notice = Astro.url.searchParams.has('saved') ? 'Страница сохранена.' : Astro.url.searchParams.has('sectionCreated') ? 'Секция добавлена.' : Astro.url.searchParams.has('sectionSaved') ? 'Секция обновлена.' : undefined;
const error = Astro.url.searchParams.get('error');
const templates = sectionTemplates;
---
<BaseLayout title={page ? `Редактирование: ${page.title}` : 'Страница не найдена'} noindex>
  <section class="mx-auto max-w-6xl px-6 py-12">
    <a class="text-sm text-primary underline" href="/admin/content/pages">← CMS-страницы</a>
    {!page ? <h1 class="mt-6 text-3xl font-semibold">Страница не найдена</h1> : <>
      <div class="mt-4 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-3xl font-semibold">{page.title}</h1><p class="mt-2 text-sm text-muted">/{page.slug === 'home' ? '' : page.slug} · {page.status}</p></div><a class="text-primary underline" href={page.slug === 'home' ? '/' : `/${page.slug}`} target="_blank">Открыть страницу ↗</a></div>
      {notice && <div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">{notice}</div>}
      {error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}
      <form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/pages/${page.id}`}>
        <h2 class="text-xl font-semibold">Настройки страницы</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2"><label>Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="title" value={page.title} required /></label><label>Slug<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" value={page.slug} required /></label><label>Статус<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="status"><option selected={page.status === 'draft'} value="draft">Черновик</option><option selected={page.status === 'published'} value="published">Опубликовано</option><option selected={page.status === 'archived'} value="archived">Архив</option></select></label><label>Robots<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="robotsDirectives" value={page.robotsDirectives} placeholder="index,follow" /></label><label>Meta title<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="metaTitle" value={page.metaTitle} /></label><label>Canonical URL<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="canonicalUrl" value={page.canonicalUrl} /></label><label class="md:col-span-2">Meta description<textarea class="mt-2 min-h-24 w-full rounded-ui border p-3" name="metaDescription">{page.metaDescription}</textarea></label><label>OG title<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="ogTitle" value={page.ogTitle} /></label><label>OG image URL<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="ogImageUrl" value={page.ogImageUrl} /></label><label class="md:col-span-2">OG description<textarea class="mt-2 min-h-24 w-full rounded-ui border p-3" name="ogDescription">{page.ogDescription}</textarea></label></div>
        <button class="mt-5 min-h-11 rounded-ui bg-primary px-5 py-3 font-semibold text-white" type="submit">Сохранить страницу</button>
      </form>
      <div class="mt-10"><h2 class="text-2xl font-semibold">Секции</h2><div class="mt-5 space-y-5">
        {page.sections.map((section, index) => <article class="rounded-xl border p-6"><div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="font-semibold">{sectionLabel(section.type)}</h3><p class="text-sm text-muted">Позиция {index + 1} · {section.isVisible ? 'видима' : 'скрыта'}</p></div><div class="flex flex-wrap gap-2"><form method="post" action={`/api/admin/sections/${section.id}`}><input type="hidden" name="pageId" value={page.id}/><button class="min-h-10 rounded-ui border px-3" name="action" value="up">↑</button><button class="min-h-10 rounded-ui border px-3" name="action" value="down">↓</button><button class="min-h-10 rounded-ui border px-3" name="action" value="toggle">{section.isVisible ? 'Скрыть' : 'Показать'}</button><button class="min-h-10 rounded-ui border border-red-200 px-3 text-red-700" name="action" value="delete">Удалить</button></form></div></div><form class="mt-4" method="post" action={`/api/admin/sections/${section.id}`}><input type="hidden" name="pageId" value={page.id}/><input type="hidden" name="action" value="update"/><input type="hidden" name="type" value={section.type}/><textarea class="min-h-40 w-full rounded-ui border p-3 font-mono text-sm" name="data">{JSON.stringify(section.data, null, 2)}</textarea><button class="mt-3 min-h-10 rounded-ui bg-primary px-4 text-sm font-semibold text-white" type="submit">Сохранить секцию</button></form></article>)}
      </div></div>
      <form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/pages/${page.id}/sections`}><h2 class="text-xl font-semibold">Добавить секцию</h2><label class="mt-5 block">Тип<select id="section-type" class="mt-2 min-h-11 w-full rounded-ui border px-3" name="type">{sectionTypes.map((type) => <option value={type}>{sectionLabel(type)}</option>)}</select></label><label class="mt-4 block">Данные JSON<textarea id="section-data" class="mt-2 min-h-40 w-full rounded-ui border p-3 font-mono text-sm" name="data">{templates.hero}</textarea></label><button class="mt-5 min-h-11 rounded-ui bg-primary px-5 py-3 font-semibold text-white" type="submit">Добавить секцию</button></form>
      <script is:inline define:vars={{ templates }}>document.getElementById('section-type')?.addEventListener('change', (event) => { const input = document.getElementById('section-data'); if (input instanceof HTMLTextAreaElement && event.target instanceof HTMLSelectElement) input.value = templates[event.target.value] ?? '{}'; });</script>
    </>}
  </section>
</BaseLayout>
