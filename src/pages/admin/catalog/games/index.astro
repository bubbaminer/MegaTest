---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listGames } from '@/lib/catalog/admin';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const games = await listGames(auth.accessToken);
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Каталог игр" noindex><section class="mx-auto max-w-6xl px-6 py-12"><p class="text-sm font-semibold text-primary">Магазин</p><h1 class="mt-2 text-3xl font-semibold">Каталог игр</h1><p class="mt-2 text-muted">Внутри каждой игры будут размещаться её товары и услуги.</p>{error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"><div class="overflow-x-auto rounded-xl border"><table class="w-full text-left text-sm"><thead class="bg-surface"><tr><th class="px-4 py-3">Игра</th><th class="px-4 py-3">Символьный код</th><th class="px-4 py-3">Статус</th><th class="px-4 py-3">Порядок</th></tr></thead><tbody>{games.map((game) => <tr class="border-t"><td class="px-4 py-4 font-medium"><a class="text-primary underline" href={`/admin/catalog/games/${game.id}`}>{game.name}</a></td><td class="px-4 py-4">{game.slug}</td><td class="px-4 py-4">{game.status}</td><td class="px-4 py-4">{game.sortOrder}</td></tr>)}</tbody></table>{games.length === 0 && <p class="p-8 text-center text-muted">Игры ещё не созданы.</p>}</div><form class="h-fit rounded-xl border p-6" method="post" action="/api/admin/catalog/games"><h2 class="text-lg font-semibold">Новая игра</h2><label class="mt-5 block">Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" required /></label><label class="mt-4 block">Символьный код<span class="mt-1 block text-xs text-muted">Часть URL латиницей, например: world-of-tanks</span><input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="game-name" required /></label><button class="mt-5 min-h-11 w-full rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Создать черновик</button></form></div></section></BaseLayout>
