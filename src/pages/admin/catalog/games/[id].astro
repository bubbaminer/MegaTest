---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGame } from '@/lib/catalog/admin';
import { listMediaAssets } from '@/lib/cms/media';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const game = Astro.params.id ? await getGame(auth.accessToken, Astro.params.id) : null;
const media = await listMediaAssets(auth.accessToken);
if (!game) Astro.response.status = 404;
const saved = Astro.url.searchParams.has('saved') || Astro.url.searchParams.has('created');
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title={game ? `Игра: ${game.name}` : 'Игра не найдена'} noindex><section class="mx-auto max-w-4xl px-6 py-12"><a class="text-sm text-primary underline" href="/admin/catalog/games">← Игры</a>{!game ? <h1 class="mt-6 text-3xl font-semibold">Игра не найдена</h1> : <><h1 class="mt-4 text-3xl font-semibold">{game.name}</h1>{saved && <div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">Изменения сохранены.</div>}{error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/catalog/games/${game.id}`}><div class="grid gap-5 md:grid-cols-2"><label>Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" value={game.name} required /></label><label>Slug<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" value={game.slug} required /></label><label>Статус<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="status"><option value="draft" selected={game.status === 'draft'}>Черновик</option><option value="active" selected={game.status === 'active'}>Активна</option><option value="hidden" selected={game.status === 'hidden'}>Скрыта</option><option value="archived" selected={game.status === 'archived'}>Архив</option></select></label><label>Порядок<input class="mt-2 min-h-11 w-full rounded-ui border px-3" type="number" min="0" name="sortOrder" value={game.sortOrder} /></label><label class="md:col-span-2">Краткое описание<textarea class="mt-2 min-h-24 w-full rounded-ui border p-3" name="shortDescription">{game.shortDescription}</textarea></label><label class="md:col-span-2">Описание<textarea class="mt-2 min-h-32 w-full rounded-ui border p-3" name="description">{game.description}</textarea></label>{[['logoMediaId','Логотип',game.logoMediaId],['imageMediaId','Изображение',game.imageMediaId],['bannerMediaId','Баннер',game.bannerMediaId]].map(([name,label,value]) => <label>{label}<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name={name}><option value="">Не выбрано</option>{media.map((asset) => <option value={asset.id} selected={value === asset.id}>{asset.filename}</option>)}</select></label>)}</div><div class="mt-6 flex flex-wrap gap-3"><button class="min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Сохранить</button><button class="min-h-11 rounded-ui border border-red-200 px-5 text-red-700" type="submit" name="action" value="archive">Архивировать</button></div></form></>}</section></BaseLayout>
