---
import BaseLayout from '@/layouts/BaseLayout.astro'; import { getGame } from '@/lib/catalog/admin'; import { listMediaAssets } from '@/lib/cms/media'; import { sectionTypes } from '@/lib/cms/sections';
import { sectionLabel, sectionTemplates } from '@/lib/cms/section-editor';
const auth=Astro.locals.auth;if(!auth)return Astro.redirect('/login');const game=Astro.params.id?await getGame(auth.accessToken,Astro.params.id):null;const media=await listMediaAssets(auth.accessToken);if(!game)Astro.response.status=404;const saved=Astro.url.searchParams.has('saved')||Astro.url.searchParams.has('created')||Astro.url.searchParams.has('sectionCreated')||Astro.url.searchParams.has('sectionSaved');const error=Astro.url.searchParams.get('error');
const templates = sectionTemplates;
---
<BaseLayout title={game?`Игра: ${game.name}`:'Игра не найдена'} noindex><section class="mx-auto max-w-5xl px-6 py-12"><a class="text-sm text-primary underline" href="/admin/catalog/games">← Каталог игр</a>{!game?<h1 class="mt-6 text-3xl font-semibold">Игра не найдена</h1>:<><div class="mt-4 flex flex-wrap items-end justify-between gap-4"><h1 class="text-3xl font-semibold">{game.name}</h1>{game.status==='active'&&<a class="text-primary underline" href={`/games/${game.slug}`} target="_blank">Открыть на сайте ↗</a>}</div>{saved&&<div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">Изменения сохранены.</div>}{error&&<div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/catalog/games/${game.id}`}><h2 class="text-xl font-semibold">Основные настройки</h2><div class="mt-5 grid gap-5 md:grid-cols-2"><label>Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" value={game.name} required/></label><label>Символьный код<span class="mt-1 block text-xs text-muted">URL: /games/{game.slug}</span><input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" value={game.slug} required/></label><label>Статус<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="status"><option value="draft" selected={game.status==='draft'}>Черновик</option><option value="active" selected={game.status==='active'}>Активна</option><option value="hidden" selected={game.status==='hidden'}>Скрыта</option><option value="archived" selected={game.status==='archived'}>Архив</option></select></label><label>Порядок<input class="mt-2 min-h-11 w-full rounded-ui border px-3" type="number" min="0" name="sortOrder" value={game.sortOrder}/></label><label class="md:col-span-2">Краткое описание<textarea class="mt-2 min-h-24 w-full rounded-ui border p-3" name="shortDescription">{game.shortDescription}</textarea></label><label class="md:col-span-2">Резервное описание<textarea class="mt-2 min-h-32 w-full rounded-ui border p-3" name="description">{game.description}</textarea></label>{[['logoMediaId','Логотип',game.logoMediaId],['imageMediaId','Изображение каталога',game.imageMediaId],['bannerMediaId','Баннер',game.bannerMediaId]].map(([name,label,value])=><label>{label}<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name={name}><option value="">Не выбрано</option>{media.map((asset)=><option value={asset.id} selected={value===asset.id}>{asset.filename}</option>)}</select></label>)}</div><div class="mt-6 flex gap-3"><button class="min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Сохранить</button><button class="min-h-11 rounded-ui border border-red-200 px-5 text-red-700" type="submit" name="action" value="archive">Архивировать</button></div></form><section class="mt-10"><h2 class="text-2xl font-semibold">Блоки страницы игры</h2><p class="mt-2 text-muted">Стандартные, товарные и E-E-A-T-блоки выводятся в указанном порядке.</p><div class="mt-6 space-y-5">{game.sections.map((section,index)=><article class="rounded-xl border p-6"><div class="flex flex-wrap justify-between gap-3"><div><h3 class="font-semibold">{sectionLabel(section.type)}</h3><p class="text-sm text-muted">Позиция {index+1} · {section.isVisible?'видим':'скрыт'}</p></div><form method="post" action={`/api/admin/catalog/game-sections/${section.id}`}><input type="hidden" name="gameId" value={game.id}/><button class="min-h-10 rounded-ui border px-3" name="action" value="up">↑</button><button class="min-h-10 rounded-ui border px-3" name="action" value="down">↓</button><button class="min-h-10 rounded-ui border px-3" name="action" value="toggle">{section.isVisible?'Скрыть':'Показать'}</button><button class="min-h-10 rounded-ui border border-red-200 px-3 text-red-700" name="action" value="delete">Удалить</button></form></div><form class="mt-4" method="post" action={`/api/admin/catalog/game-sections/${section.id}`}><input type="hidden" name="gameId" value={game.id}/><input type="hidden" name="action" value="update"/><input type="hidden" name="type" value={section.type}/><textarea class="min-h-40 w-full rounded-ui border p-3 font-mono text-sm" name="data">{JSON.stringify(section.data,null,2)}</textarea><button class="mt-3 min-h-10 rounded-ui bg-primary px-4 text-sm font-semibold text-white" type="submit">Сохранить блок</button></form></article>)}</div><form class="mt-6 rounded-xl border p-6" method="post" action={`/api/admin/catalog/games/${game.id}/sections`}><h3 class="text-lg font-semibold">Добавить блок</h3><label class="mt-4 block">Тип<select id="game-section-type" class="mt-2 min-h-11 w-full rounded-ui border px-3" name="type">{sectionTypes.map((type)=><option value={type}>{sectionLabel(type)}</option>)}</select></label><label class="mt-4 block">Данные JSON<textarea id="game-section-data" class="mt-2 min-h-40 w-full rounded-ui border p-3 font-mono text-sm" name="data">{templates.hero}</textarea></label><button class="mt-4 min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Добавить блок</button></form><script is:inline define:vars={{templates}}>document.getElementById('game-section-type')?.addEventListener('change',(event)=>{const input=document.getElementById('game-section-data');if(input instanceof HTMLTextAreaElement&&event.target instanceof HTMLSelectElement)input.value=templates[event.target.value]??'{}';});</script></section></>}</section></BaseLayout>
