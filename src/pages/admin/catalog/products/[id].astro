---
import BaseLayout from '@/layouts/BaseLayout.astro';import{listGames}from'@/lib/catalog/admin';import{getProductAdmin}from'@/lib/catalog/products-admin';import{listMediaAssets}from'@/lib/cms/media';import{deliveryTypes}from'@/lib/catalog/types';const auth=Astro.locals.auth;if(!auth)return Astro.redirect('/login');const[product,games,media]=await Promise.all([Astro.params.id?getProductAdmin(auth.accessToken,Astro.params.id):null,listGames(auth.accessToken),listMediaAssets(auth.accessToken)]);if(!product)Astro.response.status=404;const saved=Astro.url.searchParams.has('saved')||Astro.url.searchParams.has('created');const error=Astro.url.searchParams.get('error');
---
<BaseLayout title={product?`Товар: ${product.name}`:'Товар не найден'} noindex><section class="mx-auto max-w-5xl px-6 py-12"><a class="text-sm text-primary underline" href="/admin/catalog/products">← Товары</a>{!product?<h1 class="mt-6 text-3xl font-semibold">Товар не найден</h1>:<><div class="mt-4 flex flex-wrap justify-between gap-4"><h1 class="text-3xl font-semibold">{product.name}</h1>{product.status==='active'&&<a class="text-primary underline" href={`/products/${product.slug}`} target="_blank">Открыть на сайте ↗</a>}</div>{saved&&<div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">Изменения сохранены.</div>}{error&&<div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/catalog/products/${product.id}`}><div class="grid gap-5 md:grid-cols-2"><label>Игра<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="gameId" required>{games.map((game)=><option value={game.id} selected={product.gameId===game.id}>{game.name}</option>)}</select></label><label>Статус<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="status"><option value="draft" selected={product.status==='draft'}>Черновик</option><option value="active" selected={product.status==='active'}>Активен</option><option value="hidden" selected={product.status==='hidden'}>Скрыт</option><option value="archived" selected={product.status==='archived'}>Архив</option></select></label><label>Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" value={product.name} required/></label><label>Символьный код<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" value={product.slug} required/></label><label>Цена<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="price" value={product.price} inputmode="decimal" required/></label><label>Старая цена<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="oldPrice" value={product.oldPrice} inputmode="decimal"/></label><label>Валюта<input class="mt-2 min-h-11 w-full rounded-ui border px-3 uppercase" name="currency" value={product.currency} maxlength="3" required/></label><label>Порядок<input class="mt-2 min-h-11 w-full rounded-ui border px-3" type="number" min="0" name="sortOrder" value={product.sortOrder}/></label><label>Наличие<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="stockStatus"><option value="unlimited" selected={product.stockStatus==='unlimited'}>Без ограничений</option><option value="in_stock" selected={product.stockStatus==='in_stock'}>В наличии</option><option value="out_of_stock" selected={product.stockStatus==='out_of_stock'}>Нет в наличии</option><option value="preorder" selected={product.stockStatus==='preorder'}>Предзаказ</option></select></label><label>Количество<input class="mt-2 min-h-11 w-full rounded-ui border px-3" type="number" min="0" name="stockQuantity" value={product.stockQuantity}/></label><label>Тип выдачи<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="deliveryType">{deliveryTypes.map((type)=><option value={type} selected={product.deliveryType===type}>{type}</option>)}</select></label><label>Изображение<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="imageMediaId"><option value="">Не выбрано</option>{media.map((asset)=><option value={asset.id} selected={product.imageMediaId===asset.id}>{asset.filename}</option>)}</select></label><label class="md:col-span-2">Краткое описание<textarea class="mt-2 min-h-24 w-full rounded-ui border p-3" name="shortDescription">{product.shortDescription}</textarea></label><label class="md:col-span-2">Описание<textarea class="mt-2 min-h-32 w-full rounded-ui border p-3" name="description">{product.description}</textarea></label><label class="md:col-span-2">Поля для оформления заказа (JSON)<textarea class="mt-2 min-h-48 w-full rounded-ui border p-3 font-mono text-sm" name="checkoutRequirements">{product.checkoutRequirements}</textarea></label></div><div class="mt-6 flex gap-3"><button class="min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Сохранить</button><button class="min-h-11 rounded-ui border border-red-200 px-5 text-red-700" type="submit" name="action" value="archive">Архивировать</button></div></form></>}</section></BaseLayout>
