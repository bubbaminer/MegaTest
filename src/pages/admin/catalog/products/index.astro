---
import BaseLayout from '@/layouts/BaseLayout.astro';import{listGames}from'@/lib/catalog/admin';import{listProductsAdmin}from'@/lib/catalog/products-admin';const auth=Astro.locals.auth;if(!auth)return Astro.redirect('/login');const gameId=Astro.url.searchParams.get('game')??'';const[games,products]=await Promise.all([listGames(auth.accessToken),listProductsAdmin(auth.accessToken,gameId||undefined)]);const error=Astro.url.searchParams.get('error');
---
<BaseLayout title="Товары" noindex><section class="mx-auto max-w-6xl px-6 py-12"><p class="text-sm font-semibold text-primary">Каталог</p><h1 class="mt-2 text-3xl font-semibold">Товары</h1><p class="mt-2 text-muted">Каждый товар принадлежит конкретной игре.</p>{error&&<div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<form class="mt-6 flex gap-3" method="get"><select class="min-h-11 rounded-ui border px-3" name="game"><option value="">Все игры</option>{games.map((game)=><option value={game.id} selected={gameId===game.id}>{game.name}</option>)}</select><button class="rounded-ui border px-4" type="submit">Фильтровать</button></form><div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"><div class="overflow-x-auto rounded-xl border"><table class="w-full text-left text-sm"><thead class="bg-surface"><tr><th class="px-4 py-3">Товар</th><th class="px-4 py-3">Игра</th><th class="px-4 py-3">Цена</th><th class="px-4 py-3">Статус</th></tr></thead><tbody>{products.map((product)=><tr class="border-t"><td class="px-4 py-4"><a class="font-medium text-primary underline" href={`/admin/catalog/products/${product.id}`}>{product.name}</a></td><td class="px-4 py-4">{games.find((game)=>game.id===product.gameId)?.name??'—'}</td><td class="px-4 py-4">{product.price} {product.currency}</td><td class="px-4 py-4">{product.status}</td></tr>)}</tbody></table>{products.length===0&&<p class="p-8 text-center text-muted">Товаров пока нет.</p>}</div><form class="h-fit rounded-xl border p-6" method="post" action="/api/admin/catalog/products"><h2 class="text-lg font-semibold">Новый товар</h2><label class="mt-4 block">Игра<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="gameId" required><option value="">Выберите</option>{games.map((game)=><option value={game.id}>{game.name}</option>)}</select></label><label class="mt-4 block">Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" required/></label><label class="mt-4 block">Символьный код<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" placeholder="product-name" required/></label><div class="mt-4 grid grid-cols-2 gap-3"><label>Цена<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="price" inputmode="decimal" placeholder="19.99" required/></label><label>Валюта<input class="mt-2 min-h-11 w-full rounded-ui border px-3 uppercase" name="currency" value="USD" maxlength="3" required/></label></div><input type="hidden" name="deliveryType" value="manual"/><input type="hidden" name="stockStatus" value="unlimited"/><input type="hidden" name="checkoutRequirements" value="[]"/><button class="mt-5 min-h-11 w-full rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Создать черновик</button></form></div></section></BaseLayout>
