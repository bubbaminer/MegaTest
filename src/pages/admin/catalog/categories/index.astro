---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listCategories } from '@/lib/catalog/admin';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const categories = await listCategories(auth.accessToken);
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Категории — Каталог" noindex><section class="mx-auto max-w-6xl px-6 py-12"><p class="text-sm font-semibold text-primary">Каталог</p><h1 class="mt-2 text-3xl font-semibold">Категории</h1><p class="mt-2 text-muted">Категории поддерживают вложенную структуру.</p>{error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]"><div class="overflow-x-auto rounded-xl border"><table class="w-full text-left text-sm"><thead class="bg-surface"><tr><th class="px-4 py-3">Категория</th><th class="px-4 py-3">Родитель</th><th class="px-4 py-3">Статус</th></tr></thead><tbody>{categories.map((category) => <tr class="border-t"><td class="px-4 py-4 font-medium"><a class="text-primary underline" href={`/admin/catalog/categories/${category.id}`}>{category.name}</a></td><td class="px-4 py-4">{categories.find((item) => item.id === category.parentId)?.name ?? '—'}</td><td class="px-4 py-4">{category.status}</td></tr>)}</tbody></table>{categories.length === 0 && <p class="p-8 text-center text-muted">Категории ещё не созданы.</p>}</div><form class="h-fit rounded-xl border p-6" method="post" action="/api/admin/catalog/categories"><h2 class="text-lg font-semibold">Новая категория</h2><label class="mt-5 block">Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" required /></label><label class="mt-4 block">Slug<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" required /></label><label class="mt-4 block">Родитель<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="parentId"><option value="">Нет</option>{categories.map((category) => <option value={category.id}>{category.name}</option>)}</select></label><button class="mt-5 min-h-11 w-full rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Создать черновик</button></form></div></section></BaseLayout>
