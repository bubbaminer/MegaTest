---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategory, listCategories } from '@/lib/catalog/admin';
import { listMediaAssets } from '@/lib/cms/media';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const category = Astro.params.id ? await getCategory(auth.accessToken, Astro.params.id) : null;
const categories = await listCategories(auth.accessToken);
const media = await listMediaAssets(auth.accessToken);
if (!category) Astro.response.status = 404;
const saved = Astro.url.searchParams.has('saved') || Astro.url.searchParams.has('created');
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title={category ? `Категория: ${category.name}` : 'Категория не найдена'} noindex><section class="mx-auto max-w-4xl px-6 py-12"><a class="text-sm text-primary underline" href="/admin/catalog/categories">← Категории</a>{!category ? <h1 class="mt-6 text-3xl font-semibold">Категория не найдена</h1> : <><h1 class="mt-4 text-3xl font-semibold">{category.name}</h1>{saved && <div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">Изменения сохранены.</div>}{error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}<form class="mt-8 rounded-xl border p-6" method="post" action={`/api/admin/catalog/categories/${category.id}`}><div class="grid gap-5 md:grid-cols-2"><label>Название<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="name" value={category.name} required /></label><label>Slug<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="slug" value={category.slug} required /></label><label>Родитель<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="parentId"><option value="">Нет</option>{categories.filter((item) => item.id !== category.id).map((item) => <option value={item.id} selected={category.parentId === item.id}>{item.name}</option>)}</select></label><label>Статус<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="status"><option value="draft" selected={category.status === 'draft'}>Черновик</option><option value="active" selected={category.status === 'active'}>Активна</option><option value="hidden" selected={category.status === 'hidden'}>Скрыта</option><option value="archived" selected={category.status === 'archived'}>Архив</option></select></label><label>Порядок<input class="mt-2 min-h-11 w-full rounded-ui border px-3" type="number" min="0" name="sortOrder" value={category.sortOrder} /></label><label>Изображение<select class="mt-2 min-h-11 w-full rounded-ui border px-3" name="imageMediaId"><option value="">Не выбрано</option>{media.map((asset) => <option value={asset.id} selected={category.imageMediaId === asset.id}>{asset.filename}</option>)}</select></label><label class="md:col-span-2">Описание<textarea class="mt-2 min-h-32 w-full rounded-ui border p-3" name="description">{category.description}</textarea></label></div><div class="mt-6 flex gap-3"><button class="min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Сохранить</button><button class="min-h-11 rounded-ui border border-red-200 px-5 text-red-700" type="submit" name="action" value="archive">Архивировать</button></div></form></>}</section></BaseLayout>
