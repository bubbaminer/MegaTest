---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listMediaAssets } from '@/lib/cms/media';
const auth = Astro.locals.auth;
if (!auth) return Astro.redirect('/login');
const assets = await listMediaAssets(auth.accessToken);
const notice = Astro.url.searchParams.has('uploaded') ? 'Изображение загружено.' : Astro.url.searchParams.has('saved') ? 'Описание обновлено.' : Astro.url.searchParams.has('archived') ? 'Изображение архивировано. Файл сохранён для безопасного повторного использования.' : undefined;
const error = Astro.url.searchParams.get('error');
const formatSize = (bytes: number) => bytes < 1024 * 1024 ? `${Math.ceil(bytes / 1024)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
---
<BaseLayout title="Медиа-библиотека" noindex>
  <section class="mx-auto max-w-6xl px-6 py-12">
    <a class="text-sm text-primary underline" href="/admin">← Панель управления</a>
    <h1 class="mt-4 text-3xl font-semibold">Медиа-библиотека</h1>
    <p class="mt-3 text-muted">JPEG, PNG, WebP, GIF или AVIF, максимум 10 MB.</p>
    {notice && <div class="mt-6 rounded-ui border border-green-200 bg-green-50 p-4 text-green-800">{notice}</div>}
    {error && <div role="alert" class="mt-6 rounded-ui border border-red-200 bg-red-50 p-4 text-red-700">Операция не выполнена: {error}</div>}
    <form class="mt-8 rounded-xl border p-6" method="post" action="/api/admin/media" enctype="multipart/form-data">
      <h2 class="text-xl font-semibold">Загрузить изображение</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2"><label>Файл<input class="mt-2 block min-h-11 w-full rounded-ui border p-2" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" required /></label><label>Alt-текст<input class="mt-2 min-h-11 w-full rounded-ui border px-3" name="alt" placeholder="Что изображено" /></label></div>
      <button class="mt-5 min-h-11 rounded-ui bg-primary px-5 py-3 font-semibold text-white" type="submit">Загрузить</button>
    </form>
    {assets.length === 0 ? <div class="mt-8 rounded-xl border border-dashed p-10 text-center text-muted">Изображений пока нет.</div> : <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{assets.map((asset) => <article class="overflow-hidden rounded-xl border"><img class="aspect-video w-full bg-surface object-cover" src={asset.url} alt={asset.alt} loading="lazy" /><div class="p-5"><h2 class="truncate font-semibold" title={asset.filename}>{asset.filename}</h2><p class="mt-1 text-xs text-muted">{asset.mimeType} · {formatSize(asset.sizeBytes)}</p><label class="mt-4 block text-sm">Публичный URL<input class="mt-2 w-full rounded-ui border bg-surface px-3 py-2 text-xs" value={asset.url} readonly /></label><form class="mt-4" method="post" action={`/api/admin/media/${asset.id}`}><label class="text-sm">Alt-текст<input class="mt-2 min-h-10 w-full rounded-ui border px-3" name="alt" value={asset.alt} /></label><div class="mt-4 flex gap-2"><button class="min-h-10 rounded-ui bg-primary px-4 text-sm font-semibold text-white" type="submit" name="action" value="update">Сохранить</button><button class="min-h-10 rounded-ui border border-red-200 px-4 text-sm text-red-700" type="submit" name="action" value="archive">Архивировать</button></div></form></div></article>)}</div>}
  </section>
</BaseLayout>
