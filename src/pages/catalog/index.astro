---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CmsPageRenderer from '@/components/cms/CmsPageRenderer.astro';
import { getPublishedPage } from '@/lib/cms/repository';
import { listPublicGames } from '@/lib/catalog/public';
const allGames = await listPublicGames();
const query = Astro.url.searchParams.get('q')?.trim().toLocaleLowerCase('ru') ?? '';
const sort = Astro.url.searchParams.get('sort') ?? 'recommended';
const withImage = Astro.url.searchParams.get('image') === '1';
let games = allGames.filter((game) => (!query || `${game.name} ${game.shortDescription}`.toLocaleLowerCase('ru').includes(query)) && (!withImage || Boolean(game.imageUrl)));
if (sort === 'az') games = [...games].sort((a,b) => a.name.localeCompare(b.name,'ru'));
if (sort === 'za') games = [...games].sort((a,b) => b.name.localeCompare(a.name,'ru'));
const catalogContent = await getPublishedPage('catalog');
---
<BaseLayout title="Каталог игр" description="Каталог цифровых игровых товаров и услуг"><section class="mx-auto max-w-6xl px-6 py-12 sm:py-16"><p class="text-sm font-semibold text-primary">Каталог</p><h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Выберите игру</h1><p class="mt-4 max-w-2xl text-lg text-muted">Товары и услуги организованы внутри игр.</p><form class="mt-8 grid gap-3 rounded-xl border bg-surface p-4 md:grid-cols-[minmax(0,1fr)_13rem_auto_auto]" method="get"><label><span class="sr-only">Поиск игр</span><input class="min-h-11 w-full rounded-ui border bg-white px-3" type="search" name="q" value={Astro.url.searchParams.get('q') ?? ''} placeholder="Найти игру" /></label><label><span class="sr-only">Сортировка</span><select class="min-h-11 w-full rounded-ui border bg-white px-3" name="sort"><option value="recommended" selected={sort==='recommended'}>Рекомендуемые</option><option value="az" selected={sort==='az'}>От А до Я</option><option value="za" selected={sort==='za'}>От Я до А</option></select></label><label class="flex min-h-11 items-center gap-2 rounded-ui border bg-white px-3 text-sm"><input type="checkbox" name="image" value="1" checked={withImage}/>С изображением</label><button class="min-h-11 rounded-ui bg-primary px-5 font-semibold text-white" type="submit">Применить</button></form><div class="mt-4 flex items-center justify-between text-sm text-muted"><span>Найдено: {games.length}</span>{(query||withImage||sort!=='recommended')&&<a class="text-primary underline" href="/catalog/">Сбросить фильтры</a>}</div>{games.length===0?<div class="mt-10 rounded-xl border border-dashed p-10 text-center"><h2 class="text-lg font-semibold">Ничего не найдено</h2><p class="mt-2 text-muted">Измените запрос или сбросьте фильтры.</p></div>:<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{games.map((game)=><a class="group overflow-hidden rounded-xl border bg-white transition hover:-translate-y-0.5 hover:border-primary" href={`/games/${game.slug}`}>{game.imageUrl?<img class="aspect-video w-full bg-surface object-cover" src={game.imageUrl} alt={game.name} loading="lazy"/>:<div class="flex aspect-video items-center justify-center bg-primary-soft text-4xl" aria-hidden="true">🎮</div>}<div class="p-5"><div class="flex items-center gap-3">{game.logoUrl&&<img class="h-10 w-10 rounded-ui border object-cover" src={game.logoUrl} alt=""/>}<h2 class="text-xl font-semibold group-hover:text-primary">{game.name}</h2></div>{game.shortDescription&&<p class="mt-3 line-clamp-3 text-sm leading-6 text-muted">{game.shortDescription}</p>}<span class="mt-5 inline-flex text-sm font-semibold text-primary">Открыть игру →</span></div></a>)}</div>}</section>{catalogContent&&<CmsPageRenderer page={catalogContent}/>}</BaseLayout>
